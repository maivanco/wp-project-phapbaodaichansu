ENVIRONMENT=local
PROJECT_NAME=pbdcs

# Server name for FrankenPHP:
# Local development: http://pbdcs.localhost
# Production behind Host Caddy: :80
SERVER_NAME=http://pbdcs.localhost

# Port configuration
# Local dev: 80 (so http://pbdcs.localhost works directly)
# Production on VPS behind Host Caddy: set a private port (e.g. 8080, 8081)
WORDPRESS_BIND_IP=127.0.0.1
WORDPRESS_PORT=80
# Docker Compose DNS name of the MySQL service (hostname `db` is also provided as a network alias)
WORDPRESS_DB_HOST=db
WORDPRESS_DB_USER=default_user
WORDPRESS_DB_PASSWORD=default_password
WORDPRESS_DB_NAME=wp_db
WORDPRESS_DB_ROOT_PASSWORD=default_root_password
